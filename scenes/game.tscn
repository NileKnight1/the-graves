theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("17_twgab")
theme_override_font_sizes/font_size = 10
text = "Frank smuggled some prisoners with him to deflect suspicion. He used his tricks and inventions to drug the police officers, allowing him to escape without a trace or a sound. He used the same method for stealing the generators and for the kidnapping. The two men who smelled a pleasant scent were unaware that it was coming from his laboratory. He drugged them, so they forgot what they had seen there."
