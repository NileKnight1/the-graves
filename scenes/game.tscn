theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("17_twgab")
theme_override_font_sizes/font_size = 10
text = "The police gathered all the evidence and discovered that the person responsible for the escape was Victor Frank, a man who, according to his neighbors, had been insane his entire life. He would go out all day and return at night. "
label_settings = SubResource("LabelSettings_gxtfn")
horizontal_alignment = 3
autowrap_mode = 2

[node name="col2" type="Label" parent="CanvasLayer/news/pages/page1/topic1" unique_id=622632829]
