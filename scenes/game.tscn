theme_override_font_sizes/font_size = 20
text = "Victor Frankenstein"
horizontal_alignment = 3
autowrap_mode = 2

[node name="col1" type="Label" parent="CanvasLayer/news/pages/page4/topic1" unique_id=1827741137]
layout_mode = 0
offset_left = 411.0
offset_top = 174.0
offset_right = 517.0
offset_bottom = 353.0
pivot_offset = Vector2(-196, -8)
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("17_twgab")
theme_override_font_sizes/font_size = 10
text = "The police gathered all the evidence and discovered that the person responsible for the escape was Victor Frank, a man who, according to his neighbors, had been insane his entire life. He would go out all day and return at night. "
label_settings = SubResource("LabelSettings_gxtfn")
horizontal_alignment = 3
autowrap_mode = 2

[node name="col2" type="Label" parent="CanvasLayer/news/pages/page4/topic1" unique_id=1425792436]
layout_mode = 0
offset_left = 531.0
offset_top = 174.0
offset_right = 637.0
offset_bottom = 353.0
pivot_offset = Vector2(-196, -8)
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("17_twgab")
theme_override_font_sizes/font_size = 10
text = "It turned out that he had a laboratory on the outskirts of the city where he conducted his mad experiments, the latest of which involved electrically transforming a human into a monster that would serve and defend him."
label_settings = SubResource("LabelSettings_gxtfn")
horizontal_alignment = 3
autowrap_mode = 2

[node name="col3" type="Label" parent="CanvasLayer/news/pages/page4/topic1" unique_id=1393997301]
layout_mode = 0
offset_left = 656.0
offset_top = 272.0
offset_right = 865.0
offset_bottom = 325.0
pivot_offset = Vector2(-196, -8)
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("17_twgab")
theme_override_font_sizes/font_size = 10
text = " a huge number of them. He had also kidnapped the electricity company employees, drugging them in a way that rendered them incapable of thinking but simultaneously gave them strange energy. The police now is searching for him."
label_settings = SubResource("LabelSettings_gxtfn")
horizontal_alignment = 3
autowrap_mode = 2

