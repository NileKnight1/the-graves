autowrap_mode = 2

[node name="col1" type="Label" parent="CanvasLayer/news/pages/page4/topic2" unique_id=1091379967]
layout_mode = 0
offset_left = 411.0
offset_top = 380.0
offset_right = 517.0
offset_bottom = 615.0
pivot_offset = Vector2(-196, -8)
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("17_twgab")
theme_override_font_sizes/font_size = 10
text = "It was discovered that Victor was also responsible for the generator thefts, as his experiment required a huge number of generators. He had also kidnapped the electricity company employees, drugging them in a way that rendered them incapable of thinking while simultaneously giving them strange energy. They left the company with him and helped him in the escape."
label_settings = SubResource("LabelSettings_gxtfn")
horizontal_alignment = 3
autowrap_mode = 2

